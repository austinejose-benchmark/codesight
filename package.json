{
  "name": "codesight",
  "version": "0.1.0",
  "description": "Turn any repository into an explorable architecture map — free tree-sitter structure plus lean, cached summaries.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "bin": { "codesight": "bin/codesight.mjs" },
  "files": ["bin", "src", "viewer", "NOTICE"],
  "scripts": {
    "codesight": "node bin/codesight.mjs",
    "test": "node --test test/"
  },
  "keywords": ["architecture", "code-map", "tree-sitter", "knowledge-graph", "visualization"],
  "dependencies": {
    "@tree-sitter-grammars/tree-sitter-kotlin": "1.1.0",
    "fuse.js": "^7.1.0",
    "ignore": "^7.0.5",
    "tree-sitter-c-sharp": "^0.23.1",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-go": "^0.25.0",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-javascript": "^0.25.0",
    "tree-sitter-php": "^0.23.11",
    "tree-sitter-python": "^0.25.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.24.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "web-tree-sitter": "^0.26.6",
    "yaml": "^2.8.3",
    "zod": "^4.3.6"
  }
}
